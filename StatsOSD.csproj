<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>StatsOSD</RootNamespace>
    <AssemblyName>StatsOSD</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\StatsOSD.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- 版本与版权（显示在 exe 属性页、文件版本、产品版本） -->
    <Version>1.0.1</Version>
    <Product>StatsOSD</Product>
    <Company>Alooshy0827</Company>
    <Copyright>Copyright (C) 2026 Alooshy0827. All rights reserved.</Copyright>
    <Description>CPU/GPU 温度、功耗、负载 OSD 监控面板</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="assets\StatsOSD.ico" />
    <Resource Include="assets\StatsOSD.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LibreHardwareMonitorLib">
      <HintPath>libs\LibreHardwareMonitorLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
