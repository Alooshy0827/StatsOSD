<Window x:Class="StatsOSD.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="222"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="Card"
            CornerRadius="10"
            Background="#E613131E"
            BorderThickness="0"
            Padding="12,9">
        <StackPanel>
            <!-- 主数据区：四列网格，标签 / 温度(右对齐) / 功耗(左对齐) / 负载(左对齐) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CPU 行 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU"
                           FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                           Foreground="#FF8A94A6" VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="CpuTemp" Text="--" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                               Foreground="#FFE8E8F0" />
                    <TextBlock Text="°C" FontFamily="Consolas" FontSize="12" Foreground="#FF78808F"
                               VerticalAlignment="Bottom" Margin="1,0,0,4" />
                </StackPanel>
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="CpuPower" Text="--"
                           FontFamily="Consolas" FontSize="12" Foreground="#FFD8B36A"
                           TextAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,3" />
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="CpuLoad" Text="负载 --"
                           FontFamily="Consolas" FontSize="12" Foreground="#FF9AD4FF"
                           TextAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,3" />

                <!-- GPU 行 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU"
                           FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                           Foreground="#FF8A94A6" VerticalAlignment="Center" Margin="0,3,0,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,3,0,0">
                    <TextBlock x:Name="GpuTemp" Text="--" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                               Foreground="#FFE8E8F0" />
                    <TextBlock Text="°C" FontFamily="Consolas" FontSize="12" Foreground="#FF78808F"
                               VerticalAlignment="Bottom" Margin="1,0,0,4" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GpuPower" Text="--"
                           FontFamily="Consolas" FontSize="12" Foreground="#FFD8B36A"
                           TextAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,3" />
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="GpuLoad" Text="负载 --"
                           FontFamily="Consolas" FontSize="12" Foreground="#FFA7F3B0"
                           TextAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,3" />
            </Grid>

            <!-- 每核心温度：等宽小格子，自动换行对齐 -->
            <WrapPanel x:Name="CoresPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <WrapPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Width" Value="48" />
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontSize" Value="11.5" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                    </Style>
                </WrapPanel.Resources>
            </WrapPanel>

            <!-- 状态提示 -->
            <TextBlock x:Name="Warn" TextWrapping="Wrap" FontFamily="Microsoft YaHei UI" FontSize="11"
                       Foreground="#FFFFB04D" Margin="0,7,0,0" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
