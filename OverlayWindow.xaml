<Window x:Class="StatsOSD.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="120"
        MaxWidth="560"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="Card"
            CornerRadius="9"
            Background="Transparent"
            BorderThickness="0"
            Padding="6,4">
        <StackPanel x:Name="ContentStack">
            <!-- 数据区：内容由配置动态生成（见 OverlayWindow.BuildContent） -->
            <StackPanel x:Name="RowsPanel" />

            <!-- 状态提示 -->
            <TextBlock x:Name="Warn" TextWrapping="Wrap" FontFamily="Microsoft YaHei UI" FontSize="11"
                       Foreground="#FFFFB04D" Margin="0,5,0,0" Visibility="Collapsed" />

            <!-- 拖动模式提示 -->
            <TextBlock x:Name="DragHint" TextWrapping="Wrap" FontFamily="Microsoft YaHei UI" FontSize="10.5"
                       Foreground="#FF7FD4FF" Margin="0,5,0,0" Visibility="Collapsed"
                       Text="拖动调整位置" />
        </StackPanel>
    </Border>
</Window>
