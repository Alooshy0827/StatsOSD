<Window x:Class="CpuHud.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="210"
        MaxWidth="480"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="Card"
            CornerRadius="10"
            Background="#E613131E"
            BorderBrush="#99FF8A00"
            BorderThickness="1.2"
            Padding="12,8">
        <StackPanel>
            <!-- CPU 行 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CPU" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                           Foreground="#FF8A94A6" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="CpuTemp" Text="--" FontFamily="Consolas" FontSize="24" FontWeight="Bold"
                           Foreground="#FFE8E8F0" VerticalAlignment="Center" />
                <TextBlock x:Name="CpuLoad" Text="负载 --" FontFamily="Consolas" FontSize="12"
                           Foreground="#FF9AD4FF" VerticalAlignment="Center" Margin="12,0,0,4" />
            </StackPanel>

            <!-- GPU 行 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                <TextBlock Text="GPU" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                           Foreground="#FF8A94A6" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="GpuTemp" Text="--" FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                           Foreground="#FFE8E8F0" VerticalAlignment="Center" />
                <TextBlock x:Name="GpuLoad" Text="负载 --" FontFamily="Consolas" FontSize="12"
                           Foreground="#FFA7F3B0" VerticalAlignment="Center" Margin="12,0,0,4" />
            </StackPanel>

            <!-- 每核心温度 -->
            <TextBlock x:Name="Cores" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5"
                       Foreground="#FFC9CFDA" Margin="0,6,0,0" Visibility="Collapsed" />

            <!-- 状态提示 -->
            <TextBlock x:Name="Warn" TextWrapping="Wrap" FontFamily="Microsoft YaHei UI" FontSize="11.5"
                       Foreground="#FFFFB04D" Margin="0,6,0,0" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
